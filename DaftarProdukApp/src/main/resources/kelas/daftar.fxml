<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="kelas.controller.DaftarController" spacing="10" style="-fx-padding: 20;">
    <Label text="Daftar Produk Toko" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <HBox spacing="10">
        <TextField fx:id="txtCari" promptText="Cari nama produk..."/>
        <Button text="Cari" onAction="#onCari"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Tambah Produk" onAction="#onTambah"/>
        <Button text="Lihat Detail" onAction="#onDetail"/>
    </HBox>
    <TableView fx:id="tabelProduk" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colKode" text="Kode" prefWidth="100"/>
            <TableColumn fx:id="colNama" text="Nama Produk" prefWidth="200"/>
            <TableColumn fx:id="colKategori" text="Kategori" prefWidth="150"/>
            <TableColumn fx:id="colHarga" text="Harga" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>