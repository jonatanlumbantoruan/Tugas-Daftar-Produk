<?xml version="1.0" encoding="UTF-8"?>
import javafx.scene.control.*
import javafx.scene.layout.*

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="kelas.controller.FormController" spacing="15" style="-fx-padding: 20;">
    <Label text="Tambah Produk Baru" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <GridPane vgap="10" hgap="10">
        <Label text="Kode Produk:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtKode" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <Label text="Nama Produk:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtNama" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <Label text="Kategori:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="cbKategori" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        
        <Label text="Harga:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtHarga" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Simpan" onAction="#onSimpan" styleClass="btn-primary"/>
        <Button text="Batal" onAction="#onBatal"/>
    </HBox>
</VBox>